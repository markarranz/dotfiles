#!/usr/bin/env python3
import datetime
import json
import sys
import tomllib


def quote(value):
    return json.dumps(value, ensure_ascii=False).replace("\x7f", "\\u007f")


def value_toml(value):
    if isinstance(value, str):
        return quote(value)
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return repr(value)
    if isinstance(value, (datetime.datetime, datetime.date, datetime.time)):
        return value.isoformat()
    if isinstance(value, list):
        return "[" + ", ".join(value_toml(item) for item in value) + "]"
    if isinstance(value, dict):
        return "{ " + ", ".join(f"{quote(key)} = {value_toml(item)}" for key, item in value.items()) + " }"
    raise TypeError(f"Unsupported TOML value: {type(value).__name__}")


def table_lines(table, path=()):
    lines = []
    if path:
        lines.append("[" + ".".join(quote(key) for key in path) + "]")
    for key, value in table.items():
        if not isinstance(value, dict):
            lines.append(f"{quote(key)} = {value_toml(value)}")
    for key, value in table.items():
        if isinstance(value, dict):
            if lines:
                lines.append("")
            lines.extend(table_lines(value, (*path, key)))
    return lines


def section_path(section):
    table = tomllib.loads(f"[{section}]")
    path = []
    while table:
        key, table = next(iter(table.items()))
        path.append(key)
    return path


def set_value(config, section, key, value):
    table = config
    for part in section_path(section) if section else ():
        table = table.setdefault(part, {})
        if not isinstance(table, dict):
            raise ValueError(f"Expected a TOML table for {section}")
    table[key] = tomllib.loads(f"value = {value}")["value"]


def remove_section(config, section):
    path = section_path(section)
    table = config
    for part in path[:-1]:
        table = table.get(part, {})
        if not isinstance(table, dict):
            return
    table.pop(path[-1], None)


def array(values):
    return value_toml(values)


MANAGED_PLUGINS = {
    "circleci@openai-curated": "true",
    "documents@openai-primary-runtime": "false",
    "google-drive@openai-curated": "false",
    "presentations@openai-primary-runtime": "false",
    "slack@openai-curated": "false",
    "spreadsheets@openai-primary-runtime": "false",
}


config = tomllib.loads(sys.stdin.read())

set_value(config, None, "cli_auth_credentials_store", quote("keyring"))
set_value(config, None, "web_search", quote("live"))
set_value(config, None, "sandbox_mode", quote("workspace-write"))

set_value(config, "features", "hooks", "true")
config.get("features", {}).pop("multi_agent", None)
set_value(config, "features", "multi_agent_v2", "true")
set_value(config, "desktop", "external-agent-import-sync-enabled", "false")

set_value(config, "tui", "notifications", "true")
set_value(
    config,
    "tui",
    "status_line",
    array(
        [
            "model-with-reasoning",
{{- if not .forWork }}
            "five-hour-limit",
            "weekly-limit",
            "thread-credits",
            "estimated-thread-cost",
{{- end }}
            "current-dir",
            "git-branch",
            "context-remaining",
            "pull-request-number",
            "branch-changes",
            "run-state",
            "thread-title",
        ]
    ),
)
set_value(config, "tui", "status_line_use_colors", "true")

for plugin, enabled in MANAGED_PLUGINS.items():
    set_value(config, f'plugins."{plugin}"', "enabled", enabled)

remove_section(config, 'plugins."browser-use@openai-bundled"')
remove_section(config, "mcp_servers.circleci.env")
remove_section(config, "mcp_servers.circleci")

output = "\n".join(table_lines(config)).rstrip() + "\n"
tomllib.loads(output)
sys.stdout.write(output)
