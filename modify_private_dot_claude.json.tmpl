#!/usr/bin/env python3
import json
import sys

text = sys.stdin.read()
{{- if .forWork }}
settings = json.loads(text) if text.strip() else {}
settings.get("mcpServers", {}).pop("mempalace", None)
sys.stdout.write(json.dumps(settings, indent=2, ensure_ascii=False) + ("\n" if text.endswith("\n") else ""))
{{- else }}
sys.stdout.write(text)
{{- end }}
