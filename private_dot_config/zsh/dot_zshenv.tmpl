export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export ZDOTDIR="${ZDOTDIR:-$XDG_CONFIG_HOME/zsh}"
export ZSH_COMPLETIONS_DIR="${ZSH_COMPLETIONS_DIR:-$XDG_DATA_HOME/zsh/completions}"

if command -v nvim >/dev/null 2>&1; then
  export EDITOR="nvim"
  export VISUAL="nvim"
  export MANPAGER="nvim +Man!"
elif command -v vim >/dev/null 2>&1; then
  export EDITOR="vim"
  export VISUAL="vim"
else
  export EDITOR="vi"
  export VISUAL="vi"
fi

# Lazygit reads this regardless of how it's invoked (alias-less subshells, nvim :terminal, etc.)
export LG_CONFIG_FILE="${XDG_CONFIG_HOME}/lazygit/config.yml,${XDG_CONFIG_HOME}/lazygit/theme.yml"

{{- if eq .chezmoi.os "linux" }}

# Make electron apps wayland aware:
export ELECTRON_OZONE_PLATFORM_HINT=wayland

{{- end }}
